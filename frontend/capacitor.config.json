{
  "appId": "com.milkmaatu.app",
  "appName": "MilkMaatu",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "milkfront1.onrender.com",
      "*.onrender.com",
      "milkmaatu.com",
      "*.milkmaatu.com"
    ]
  },
  "android": {
    "zoomEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_ic_notification",
      "iconColor": "#D97706"
    }
  }
}
